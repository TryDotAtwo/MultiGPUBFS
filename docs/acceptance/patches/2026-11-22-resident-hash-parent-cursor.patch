diff --git a/cuda/device_parent_cursor.cuh b/cuda/device_parent_cursor.cuh
new file mode 100644
index 0000000..4d85c5e
--- /dev/null
+++ b/cuda/device_parent_cursor.cuh
@@ -0,0 +1,26 @@
+#pragma once
+#include <cstdint>
+
+// Per-producer position in the immutable read bank of one layer. Parents
+// assigned to a producer have strictly increasing ordinals. Other banks may
+// change during the layer; Count must read only the immutable read bank.
+namespace mgbfs_parent_cursor {
+struct Cursor { uint64_t extent=0,base=0; };
+template<class Count>
+__device__ inline bool locate(Cursor& cursor,uint64_t extent_count,uint64_t parent,
+                              Count count,uint64_t* extent,uint64_t* row) {
+  if(!extent || !row || cursor.extent>extent_count || parent<cursor.base)return false;
+  uint64_t remaining=parent-cursor.base;
+  while(cursor.extent<extent_count) {
+    const uint64_t n=count(cursor.extent);
+    if(n>UINT64_MAX-cursor.base)return false;
+    if(remaining<n) {
+      *extent=cursor.extent;*row=remaining;return true;
+    }
+    remaining-=n;
+    cursor.base+=n;
+    ++cursor.extent;
+  }
+  return false;
+}
+}
