new file mode 100644
index 0000000..40ecac4
--- /dev/null
+++ b/tests/device_resident_hash_parent_cursor_compat_gpu.py
@@ -0,0 +1,34 @@
+"""Explicit cursor requests must fail on older resident hash libraries."""
+import json,os,tempfile
+from pathlib import Path
+from multigpubfs import GraphDefinition,run_graph
+from multigpubfs.generic_session import persistent_graph_workers
+
+root=Path(tempfile.mkdtemp(prefix="resident-hash-parent-compat-",dir=os.environ.get("MGBFS_TEST_TMP_ROOT")))
+os.environ["LD_LIBRARY_PATH"]=os.environ["RESIDENT_OLD_LIB"]+":"+os.environ["RESIDENT_LD_TAIL"]
+graph=GraphDefinition.permutation([[1,0,2,3],[0,2,1,3],[0,1,3,2]],[0,1,2,3])
+layers=graph.exact_layers(1000)
+def run(out):
+ return run_graph(graph,out,devices=[0,1],autotune=False,shards=2,_batch=8,segment_rows=64,
+  memory_backend="segmented24",segment_strategy="atomic",execution_engine="device",
+  executable=os.environ["MGBFS_EXECUTABLE"])
+
+os.environ["MGBFS_RESIDENT_HASH_PARENT_CURSOR"]="1"
+out=root/"unsupported"
+with persistent_graph_workers():
+ try:run(out)
+ except RuntimeError as e:assert "NATIVE_DISTRIBUTED_RANK_FAILED" in str(e),e
+ else:raise AssertionError("old library silently accepted an unsupported parent cursor")
+ logs="".join((out/f"rank-{r}.log").read_text() for r in (0,1))
+ assert "RESIDENT_HASH_PARENT_CURSOR_UNSUPPORTED" in logs,logs
+ assert not (out/"report.json").exists()
+print("PASS old library rejects explicit cursor",flush=True)
+os.environ.pop("MGBFS_RESIDENT_HASH_PARENT_CURSOR",None)
+with persistent_graph_workers():
+ r=run(root/"supported")
+ assert r["status"]=="COMPLETE" and r["layer_sizes"]==[len(x) for x in layers],r
+ assert r["runtime_identity"]["cuda_library_sha256"]==os.environ["RESIDENT_OLD_SHA"]
+print("PASS old library retains default path",flush=True)
+(root/"acceptance.json").write_text(json.dumps({"world":2,"old_cuda_library_sha256":os.environ["RESIDENT_OLD_SHA"],
+ "unsupported_explicit_cursor":True,"default_layers":[len(x) for x in layers]},indent=2))
+print("EVIDENCE",root,flush=True)
