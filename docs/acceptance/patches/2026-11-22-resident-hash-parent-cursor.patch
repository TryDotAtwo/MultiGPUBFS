@@ -0,0 +1,79 @@
+#include "device_parent_cursor.cuh"
+#include <cuda_runtime.h>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+struct Counts {
+  const uint64_t* values;
+  __device__ uint64_t operator()(uint64_t i) const { return values[i]; }
+};
+struct Position { uint64_t ok,extent,row; };
+
+__global__ void locate_all(const uint64_t* counts,uint64_t n,
+                           const uint64_t* parents,uint64_t pcount,Position* out) {
+  if (threadIdx.x || blockIdx.x) return;
+  mgbfs_parent_cursor::Cursor cursor{};
+  for (uint64_t i=0;i<pcount;++i) {
+    uint64_t extent=0,row=0;
+    bool ok=mgbfs_parent_cursor::locate(cursor,n,parents[i],Counts{counts},&extent,&row);
+    out[i]={uint64_t(ok),extent,row};
+  }
+}
+__global__ void invalid_cases(uint32_t* result) {
+  if (threadIdx.x || blockIdx.x) return;
+  uint64_t extent=0,row=0;
+  const uint64_t overflow[]={UINT64_MAX,1};
+  mgbfs_parent_cursor::Cursor first{};
+  const bool accepted_overflow=mgbfs_parent_cursor::locate(
+      first,2,UINT64_MAX,Counts{overflow},&extent,&row);
+  const uint64_t normal[]={3,5};
+  mgbfs_parent_cursor::Cursor second{};
+  const bool initial=mgbfs_parent_cursor::locate(second,2,4,Counts{normal},&extent,&row);
+  const bool accepted_rewind=mgbfs_parent_cursor::locate(second,2,2,Counts{normal},&extent,&row);
+  *result=(!accepted_overflow&&initial&&!accepted_rewind)?1u:0u;
+}
+static void checked(cudaError_t e) {
+  if(e!=cudaSuccess) { std::fprintf(stderr,"CUDA error: %s\n",cudaGetErrorString(e)); std::exit(1); }
+}
+int main() {
+  int ndevice=0;
+  if(cudaGetDeviceCount(&ndevice)!=cudaSuccess || !ndevice)return 77;
+  // Deliberately includes empty extents and virtual boundaries at 2^32.
+  // Only metadata is allocated; this does not allocate 2^32 physical rows.
+  const std::vector<uint64_t> counts={0,2,0,1,uint64_t(1)<<32,0,3};
+  const std::vector<uint64_t> parents={0,1,2,3,(uint64_t(1)<<32)-1,
+    uint64_t(1)<<32,(uint64_t(1)<<32)+1,(uint64_t(1)<<32)+2,(uint64_t(1)<<32)+5,(uint64_t(1)<<32)+6};
+  std::vector<Position> got(parents.size());
+  uint64_t *dc=nullptr,*dp=nullptr;Position* dout=nullptr;
+  checked(cudaMalloc(&dc,counts.size()*sizeof(uint64_t)));
+  checked(cudaMalloc(&dp,parents.size()*sizeof(uint64_t)));
+  checked(cudaMalloc(&dout,got.size()*sizeof(Position)));
+  checked(cudaMemcpy(dc,counts.data(),counts.size()*sizeof(uint64_t),cudaMemcpyHostToDevice));
+  checked(cudaMemcpy(dp,parents.data(),parents.size()*sizeof(uint64_t),cudaMemcpyHostToDevice));
+  locate_all<<<1,1>>>(dc,counts.size(),dp,parents.size(),dout);
+  checked(cudaGetLastError());
+  checked(cudaMemcpy(got.data(),dout,got.size()*sizeof(Position),cudaMemcpyDeviceToHost));
+  for(size_t i=0;i<parents.size();++i) {
+    uint64_t left=parents[i],extent=0;
+    while(extent<counts.size() && left>=counts[extent])left-=counts[extent++];
+    bool ok=extent<counts.size();
+    if(got[i].ok!=uint64_t(ok) || (ok && (got[i].extent!=extent || got[i].row!=left))) {
+      std::fprintf(stderr,"parent=%llu got=%llu:%llu:%llu want=%d:%llu:%llu\n",
+        (unsigned long long)parents[i],(unsigned long long)got[i].ok,
+        (unsigned long long)got[i].extent,(unsigned long long)got[i].row,
+        int(ok),(unsigned long long)extent,(unsigned long long)left);
+      return 1;
+    }
+  }
+  uint32_t *invalid=nullptr,checked_invalid=0;
+  checked(cudaMalloc(&invalid,sizeof(uint32_t)));
+  invalid_cases<<<1,1>>>(invalid);
+  checked(cudaGetLastError());
+  checked(cudaMemcpy(&checked_invalid,invalid,sizeof(uint32_t),cudaMemcpyDeviceToHost));
+  if(checked_invalid!=1){std::fprintf(stderr,"cursor accepted overflow or an invalid rewind\n");return 1;}
+  checked(cudaFree(invalid));checked(cudaFree(dc));checked(cudaFree(dp));checked(cudaFree(dout));
+  std::puts("PASS parent cursor: empty extents, jumps, overflow and virtual 2^32 row boundary");
